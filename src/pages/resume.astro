---
import BaseLayout from '../layouts/BaseLayout.astro';

const resumePath = '/documents/Resume_Siddhartha_Varma.pdf';

const resumeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: 'https://sidv.dev/resume/',
  name: 'Siddhartha Varma Resume',
  description:
    'Resume of Siddhartha Varma, a backend and systems engineer specializing in Go, distributed workflows, search infrastructure, and reliable product platforms.',
  mainEntity: {
    '@type': 'Person',
    name: 'Siddhartha Varma',
    url: 'https://sidv.dev',
    jobTitle: 'Backend and Systems Engineer',
    sameAs: [
      'https://github.com/BRO3886',
      'https://linkedin.com/in/siddharthav22/',
    ],
    knowsAbout: [
      'Go',
      'Distributed systems',
      'Search infrastructure',
      'Temporal',
      'PostgreSQL',
      'Redis',
      'Kafka',
    ],
  },
};
---

<BaseLayout
  title="Siddhartha Varma Resume | Backend & Systems Engineer"
  description="Resume of Siddhartha Varma, a backend and systems engineer with 4+ years of experience in Go, distributed workflows, search infrastructure, and reliable product platforms."
  ogType="profile"
  jsonLd={resumeJsonLd}
>
  <section class="resume-page">
    <div class="resume-shell">
      <header class="resume-heading">
        <div>
          <h1>Resume</h1>
          <p>
            Backend and systems engineer with 4+ years of experience building distributed workflows,
            search infrastructure, and reliable product platforms in Go.
          </p>
        </div>
        <a
          href={resumePath}
          type="application/pdf"
          download="Resume_Siddhartha_Varma.pdf"
          data-resume-download
          class="resume-download"
        >
          <span class="resume-download-icon resume-download-icon--default">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
          </span>
          <span class="resume-download-icon resume-download-icon--done">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
          </span>
          <span class="resume-download-label resume-download-label--default">Download PDF</span>
          <span class="resume-download-label resume-download-label--done">Downloading</span>
        </a>
      </header>

      <div class="resume-reader" aria-label="Resume preview">
        <img
          src="/images/resume/page-1.png"
          alt="First page of Siddhartha Varma's resume"
          width="1237"
          height="1600"
          class="resume-sheet"
        />
        <img
          src="/images/resume/page-2.png"
          alt="Second page of Siddhartha Varma's resume"
          width="1237"
          height="1600"
          loading="lazy"
          class="resume-sheet"
        />
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var downloadLink = document.querySelector('[data-resume-download]');
      if (!downloadLink) return;

      downloadLink.addEventListener('click', function () {
        if (window.posthog) {
          posthog.capture('resume_download', {
            file_name: 'Resume_Siddhartha_Varma.pdf',
            source: 'resume_page',
          });
        }

        downloadLink.classList.add('is-downloading');
        downloadLink.setAttribute('aria-label', 'Downloading PDF');
        window.setTimeout(function () {
          downloadLink.classList.remove('is-downloading');
          downloadLink.removeAttribute('aria-label');
        }, 1600);
      });
    })();
  </script>
</BaseLayout>

<style>
  .resume-page {
    --resume-reader: oklch(0.16 0.008 75);
    --resume-rule: oklch(0.31 0.012 75);
    padding: clamp(3rem, 8vw, 6rem) 1.5rem;
  }

  :global([data-theme='light']) .resume-page {
    --resume-reader: oklch(0.91 0.012 75);
    --resume-rule: oklch(0.78 0.014 75);
  }

  .resume-shell { margin: 0 auto; max-width: 52rem; }
  .resume-heading { align-items: center; display: flex; gap: 1.5rem; justify-content: space-between; margin-bottom: 1.5rem; }
  .resume-heading h1 { color: var(--color-text-primary); font-size: clamp(2rem, 5vw, 2.75rem); font-weight: 650; letter-spacing: -0.035em; line-height: 0.95; margin: 0; }
  .resume-heading p { color: var(--color-text-secondary); line-height: 1.6; margin: 0.75rem 0 0; max-width: 42rem; }

  .resume-download { align-items: center; background: var(--color-primary); border-radius: 0.5rem; color: var(--color-text-on-primary); display: inline-flex; flex: none; font-size: 0.875rem; font-weight: 500; gap: 0.4rem; justify-content: center; overflow: hidden; padding: 0.625rem 1.25rem; position: relative; text-decoration: none; transition: background-color 280ms cubic-bezier(0.16, 1, 0.3, 1), color 280ms cubic-bezier(0.16, 1, 0.3, 1), transform 280ms cubic-bezier(0.16, 1, 0.3, 1); }
  .resume-download:hover { background: var(--color-primary-hover); }
  .resume-download-icon { align-items: center; display: flex; transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1), transform 300ms cubic-bezier(0.16, 1, 0.3, 1); }
  .resume-download svg { height: 1rem; width: 1rem; }
  .resume-download-icon--done { left: 1.25rem; opacity: 0; position: absolute; transform: scale(0.5) rotate(-10deg); }
  .resume-download-label { transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1), transform 300ms cubic-bezier(0.16, 1, 0.3, 1); }
  .resume-download-label--done { left: 2.55rem; opacity: 0; position: absolute; transform: translateY(4px); }
  .resume-download.is-downloading .resume-download-icon--default, .resume-download.is-downloading .resume-download-label--default { opacity: 0; }
  .resume-download.is-downloading .resume-download-icon--default { transform: scale(0.5) rotate(10deg); }
  .resume-download.is-downloading .resume-download-label--default { transform: translateY(-4px); }
  .resume-download.is-downloading .resume-download-icon--done { opacity: 1; transform: scale(1) rotate(0); }
  .resume-download.is-downloading .resume-download-label--done { opacity: 1; transform: translateY(0); }
  .resume-download:active { transform: scale(0.97); }
  .resume-download:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }

  .resume-reader { background: var(--resume-reader); border: 1px solid var(--resume-rule); border-radius: 0.75rem; display: grid; gap: clamp(1rem, 3vw, 1.5rem); padding: clamp(0.75rem, 3vw, 1.5rem); }
  .resume-sheet { background: white; border-radius: 0.375rem; box-shadow: 0 0.75rem 2.5rem oklch(0 0 0 / 0.2); display: block; height: auto; margin: 0 auto; max-width: 100%; width: 100%; }

  @media (max-width: 40rem) {
    .resume-heading { align-items: start; flex-direction: column; }
    .resume-download { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) { .resume-download { transition: none; } }
</style>

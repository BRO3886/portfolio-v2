---
import '../styles/theme.css';
import { bookingUrl, socialLinks } from '../lib/content';
import PostHog from '../components/PostHog.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  jsonLd?: Record<string, unknown>;
  overlayHeader?: boolean;
}

const {
  title,
  description = 'Portfolio website of Siddhartha Varma',
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  author,
  jsonLd,
  overlayHeader = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const emailLink = socialLinks.find((link) => link.url.startsWith('mailto:'));
const elsewhereLinks = socialLinks.filter((link) => link !== emailLink);
const email = emailLink?.url.replace('mailto:', '');
const calendarIcon = `<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>`;
const resolvedOgImage =ogImage ? new URL(ogImage, Astro.site).href : undefined;
const markdownPath = currentPath === '/'
  ? '/index.md'
  : currentPath === '/resume/'
    ? '/resume.md'
    : currentPath === '/blog/'
      ? '/blog/index.md'
      : currentPath.match(/^\/blog\/([^/]+)\/$/)?.[1]
        ? `${currentPath.slice(0, -1)}.md`
        : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Prevent FOUC: dark is the CSS default, only apply light if explicitly chosen -->
    <script is:inline>
      (function() {
        if (localStorage.getItem('theme') === 'light') document.documentElement.setAttribute('data-theme', 'light');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL.href} />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}

    <!-- Font Preloading -->
    <link rel="preload" href="/fonts/SourceSans3/SourceSans3-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Lora/Lora-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrains_Mono/JetBrainsMono-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="Siddhartha Varma" />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    {resolvedOgImage && <meta property="og:image:alt" content={title} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={resolvedOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    {resolvedOgImage && <meta name="twitter:image:alt" content={title} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Siddhartha Varma's Blog" href="/rss.xml" />
    <title>{title}</title>

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <PostHog />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-text-primary">
    <header class:list={['border-b border-border', { 'header-overlay': overlayHeader }]}>
      <nav class="max-w-4xl mx-auto px-6 py-5 flex items-center justify-between">
        <a href="/" class="text-lg font-semibold tracking-tight text-text-primary hover:text-primary transition-colors">
          Siddhartha Varma
        </a>
        <div class="flex items-center gap-6 text-sm">
          <a
            href="/"
            class:list={[
              'transition-colors',
              currentPath === '/' ? 'text-text-primary font-medium' : 'text-text-secondary hover:text-text-primary',
            ]}
          >
            Home
          </a>
          <a
            href="/blog"
            class:list={[
              'transition-colors',
              currentPath.startsWith('/blog') ? 'text-text-primary font-medium' : 'text-text-secondary hover:text-text-primary',
            ]}
          >
            Blog
          </a>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle theme"
            class="p-1.5 rounded-lg text-text-secondary hover:text-text-primary hover:bg-surface transition-colors"
          >
            <!-- Sun icon (shown in dark mode) -->
            <svg class="hidden dark-icon w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg class="hidden light-icon w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border mt-auto">
      <div class="max-w-4xl mx-auto px-6 pt-14 pb-8">
        <div class="footer-grid">
          <div>
            <p class="footer-label">Say hello</p>
            <p class="text-xl font-semibold tracking-tight text-text-primary mb-2 footer-heading">
              Building something interesting? Let’s talk.
            </p>
            <p class="text-sm text-text-tertiary leading-relaxed mb-6 max-w-[40ch]">
              Pick a slot on my calendar, or write to <a href={emailLink?.url} class="footer-inline-link">{email}</a>.
            </p>
            <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="footer-book" id="footer-book">
              <Fragment set:html={calendarIcon} />
              Book a call
              <span class="footer-book-arrow">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
              </span>
            </a>
          </div>
          <nav aria-label="Site">
            <p class="footer-label">Site</p>
            <ul class="footer-list">
              <li><a href="/">Home</a></li>
              <li><a href="/blog">Blog</a></li>
              <li><a href="/resume">Resume</a></li>
              <li><a href="/rss.xml">RSS</a></li>
            </ul>
          </nav>
          <nav aria-label="Elsewhere">
            <p class="footer-label">Elsewhere</p>
            <ul class="footer-list">
              {elsewhereLinks.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    <Fragment set:html={link.icon} />
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Siddhartha Varma</p>
          <p>Built with Astro, served from Cloudflare</p>
        </div>
      </div>

      <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="book-fab" id="book-fab" aria-label="Book a call">
        <span class="book-fab-label" aria-hidden="true">Book a call</span>
        <span class="book-fab-icon"><Fragment set:html={calendarIcon} /></span>
      </a>
    </footer>

    <script is:inline>
      (function() {
        function isLight() {
          return document.documentElement.getAttribute('data-theme') === 'light';
        }

        function updateIcons() {
          var light = isLight();
          var darkIcons = document.querySelectorAll('.dark-icon');
          var lightIcons = document.querySelectorAll('.light-icon');
          darkIcons.forEach(function(el) { el.style.display = light ? 'none' : 'block'; });
          lightIcons.forEach(function(el) { el.style.display = light ? 'block' : 'none'; });
        }

        updateIcons();

        var toggle = document.getElementById('theme-toggle');
        if (toggle) {
          toggle.addEventListener('click', function() {
            var newTheme;
            if (isLight()) {
              document.documentElement.removeAttribute('data-theme');
              localStorage.setItem('theme', 'dark');
              newTheme = 'dark';
            } else {
              document.documentElement.setAttribute('data-theme', 'light');
              localStorage.setItem('theme', 'light');
              newTheme = 'light';
            }
            updateIcons();
            if (window.posthog) { posthog.capture('theme_toggle', { new_theme: newTheme }); }
          });
        }
      })();
    </script>

    <script is:inline>
      (function() {
        var fab = document.getElementById('book-fab');
        var footerBook = document.getElementById('footer-book');
        if (!fab || !footerBook) return;
        var footerBookVisible = false;

        function update() {
          var pastFold = window.scrollY > window.innerHeight * 0.5;
          fab.toggleAttribute('data-shown', pastFold && !footerBookVisible);
        }

        new IntersectionObserver(function(entries) {
          footerBookVisible = entries[0].isIntersecting;
          update();
        }).observe(footerBook);

        window.addEventListener('scroll', update, { passive: true });
        update();
      })();
    </script>

    <script is:inline>
      document.addEventListener('click', function(e) {
        var link = e.target.closest('a');
        if (!link) return;
        try {
          var url = new URL(link.href, window.location.origin);
          if (url.hostname && url.hostname !== window.location.hostname && window.posthog) {
            posthog.capture('outbound_link_click', {
              url: link.href,
              link_text: (link.textContent || '').trim().substring(0, 200),
            });
          }
        } catch (_) {}
      });
    </script>
  </body>
</html>

<style>
  .header-overlay {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 20;
    border-color: transparent;
    --color-text-primary: var(--color-text-on-photo);
    --color-text-secondary: var(--color-text-on-photo-muted);
    --color-primary: var(--color-text-on-photo);
    --color-surface: var(--color-surface-on-photo);
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.7fr) minmax(0, 0.9fr);
    }
  }

  .footer-heading {
    text-wrap: balance;
  }

  .footer-label {
    margin-bottom: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .footer-list {
    display: grid;
    gap: 0.25rem;
    font-size: 0.875rem;
  }

  .footer-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    color: var(--color-text-secondary);
    transition: color 150ms ease;
  }

  .footer-list a:hover {
    color: var(--color-text-primary);
  }

  .footer-list :global(svg) {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--color-text-tertiary);
  }

  .footer-inline-link {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-border-hover);
    text-underline-offset: 3px;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .footer-inline-link:hover {
    color: var(--color-text-primary);
    text-decoration-color: currentColor;
  }

  .footer-book {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1.25rem;
    border-radius: 0.5rem;
    background: var(--color-primary);
    color: var(--color-text-on-primary);
    font-size: 0.875rem;
    font-weight: 500;
    transition: background-color 150ms ease, scale 150ms ease-out;
  }

  .footer-book:hover {
    background: var(--color-primary-hover);
  }

  .footer-book:active {
    scale: 0.97;
  }

  .footer-book-arrow {
    display: flex;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-book:hover .footer-book-arrow {
    transform: translate(2px, -2px);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
  }

  .book-fab {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 30;
    display: flex;
    align-items: center;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity 220ms cubic-bezier(0.32, 0.72, 0, 1), transform 220ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .book-fab[data-shown] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .book-fab:focus-visible {
    outline: none;
  }

  .book-fab:focus-visible .book-fab-icon {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (min-width: 640px) {
    .book-fab {
      right: 1.5rem;
      bottom: 1.5rem;
    }
  }

  .book-fab-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-text-on-primary);
    /* iOS Safari clips fixed elements at the viewport's bottom edge, so the shadow must not reach past the button's bottom offset. */
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2), 0 4px 10px rgb(0 0 0 / 0.18);
    transition: background-color 150ms ease, scale 150ms ease-out;
  }

  .book-fab:active .book-fab-icon {
    scale: 0.94;
  }

  .book-fab-label {
    position: absolute;
    right: calc(100% + 0.6rem);
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    color: var(--color-text-primary);
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(6px);
    pointer-events: none;
    transition: opacity 150ms ease-out, transform 150ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .book-fab:hover .book-fab-icon {
      background: var(--color-primary-hover);
    }

    .book-fab:hover .book-fab-label {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .book-fab:focus-visible .book-fab-label {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .book-fab,
    .book-fab-label,
    .footer-book-arrow {
      transition: none;
    }

    .book-fab,
    .book-fab[data-shown] {
      transform: none;
    }

    .footer-book:active,
    .book-fab:active .book-fab-icon {
      scale: 1;
    }
  }

  @media print {
    .book-fab {
      display: none;
    }
  }
</style>
